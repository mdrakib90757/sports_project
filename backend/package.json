{
  "name": "kpl-backend",
  "version": "1.0.0",
  "description": "Kosnapur Premier League Clean Architecture Backend",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "build": "tsc",
    "start": "node dist/interfaces/http/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/drizzle/migrate.ts",
    "db:seed": "tsx src/infrastructure/database/drizzle/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.17.24",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
